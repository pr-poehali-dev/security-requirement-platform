# Режим БД: sqlite или postgresql
DB_TYPE=sqlite

# SQLite (по умолчанию, для локальной разработки)
DATABASE_URL=sqlite:///./secarch.db

# PostgreSQL (раскомментируй при использовании Postgres)
# DATABASE_URL=postgresql://secarch:secarch@localhost:5432/secarch

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=secarch
S3_PUBLIC_URL=http://localhost:9000/secarch

# Auth
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
